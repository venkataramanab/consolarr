<!-- Platform stacks: no cleartext, system trust anchors only. Self-signed
     servers are handled by trust-on-first-use pinning in Dart (W3). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
