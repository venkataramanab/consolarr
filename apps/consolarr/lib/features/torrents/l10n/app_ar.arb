    "description": "Torrent state: complete and idle."
  },
  "torStateError": "خطأ",
  "@torStateError": {
    "description": "Torrent state: the client reports an error for this torrent."
  },
  "torStateUnknown": "غير معروف",
  "@torStateUnknown": {
    "description": "Torrent state: the client reported a state the app does not know."
  },
  "torProgressPercent": "{value}",
  "@torProgressPercent": {
    "description": "Percentage of a torrent that is complete, for example 45%.",
    "placeholders": {
      "value": {
        "type": "double",
        "description": "Fraction from 0 to 1.",
        "format": "percentPattern",
        "optionalParameters": {
          "decimalDigits": 0
        }
      }
    }
  },
