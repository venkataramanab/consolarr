      "progress": {
        "type": "double",
        "description": "Fraction from 0 to 1.",
        "format": "decimalPercentPattern",
        "optionalParameters": {
          "decimalDigits": 0
        }
      }
    }
  },
  "arrCommonQueueSizeMb": "{size} ميغابايت",
