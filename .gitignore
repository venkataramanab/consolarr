# Dart / Flutter
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
.fvm/flutter_sdk
coverage/
*.iml
.idea/
.vscode/
*.log

# Secrets and signing material (never commit)
*.jks
*.keystore
key.properties
.env
.env.*
dart_defines*.json
!dart_defines.example.json
local.properties
google-services.json
GoogleService-Info.plist

# Android
**/android/.gradle/
**/android/captures/
**/android/gradle-wrapper.jar
**/android/app/debug
**/android/app/profile
**/android/app/release
**/android/**/GeneratedPluginRegistrant.*
.kotlin/

# drift generated code is built by `dart run build_runner build` (CI does it in
# the setup-flutter action); it is never committed.
apps/consolarr/lib/src/database/*.g.dart

# Local tooling output
.melos_tool/
debug-info/

# Golden test failure artefacts (uploaded by CI on failure, never committed)
**/test/failures/

# Certificates and keys for tests are generated at test time into this
# directory and never committed (see tools/ci/repo_guard.sh)
**/test/.generated/
